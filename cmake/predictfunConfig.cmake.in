@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
include(FetchContent)
find_dependency(OpenSSL)
if(NOT TARGET Boost::beast OR NOT TARGET Boost::asio)
    find_dependency(Boost 1.87 CONFIG COMPONENTS beast asio)
endif()

# Order hashing and the optional local signer use the exact same audited
# primitives as the source build.  Keep this immutable dependency out of the
# public C++ API while restoring the static link edge for installed consumers.
set(PREDICTFUN_IZAN_CRYPTO_SOURCE_DIR "" CACHE PATH
    "Optional pre-verified local izan-crypto source")
if(NOT TARGET izan::eip712 OR NOT TARGET izan::secp256k1)
    if(PREDICTFUN_IZAN_CRYPTO_SOURCE_DIR)
        FetchContent_Declare(izan_crypto_dependency
            SOURCE_DIR "${PREDICTFUN_IZAN_CRYPTO_SOURCE_DIR}"
            EXCLUDE_FROM_ALL
        )
    else()
        FetchContent_Declare(izan_crypto_dependency
            URL https://github.com/izandotai/izan-crypto/archive/8c6857d911da89a229e6a9911e984601e7cf15fa.tar.gz
            URL_HASH SHA256=E70B9BA33D93D98D052A73F88E3A56F340234E3BC8B3B91BE2E5D676DE682149
            DOWNLOAD_EXTRACT_TIMESTAMP TRUE
            EXCLUDE_FROM_ALL
        )
    endif()
    FetchContent_MakeAvailable(izan_crypto_dependency)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/predictfunTargets.cmake")

set_property(TARGET predictfun::order APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES "$<LINK_ONLY:izan::eip712>"
)
if(TARGET predictfun::local_signer)
    set_property(TARGET predictfun::local_signer APPEND PROPERTY
        INTERFACE_LINK_LIBRARIES "$<LINK_ONLY:izan::secp256k1>"
    )
endif()

# The source build uses a pinned FetchContent Boost tree.  Attach Boost only
# after importing our installed targets so the export remains independent of
# FetchContent's private target names while consumers still inherit the public
# header dependency.
set_property(TARGET predictfun::net APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES Boost::beast Boost::asio
)
check_required_components(predictfun)
